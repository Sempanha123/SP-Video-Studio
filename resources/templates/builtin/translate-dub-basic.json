{
  "id": "builtin-translate-dub-basic",
  "name": "Translate & Dub Basic",
  "templateType": "project",
  "category": "General Video",
  "description": "Translate & Dub structure with target-language and voice placeholders; no source media or generated audio is embedded.",
  "workflow": "translate",
  "version": "1.0",
  "schemaVersion": 1,
  "builtin": true,
  "authorLabel": "MMO Video Studio",
  "previewImage": "",
  "tags": [
    "translate",
    "dub",
    "multilingual"
  ],
  "supportedAspectRatios": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "supportedLanguages": [
    "*"
  ],
  "requiredFeatures": [
    "dubbing",
    "translation",
    "subtitles",
    "tts"
  ],
  "components": [
    {
      "localId": "project_settings",
      "type": "project_settings",
      "data": {
        "workflow": "translate",
        "fps": 30,
        "languageMode": "project"
      }
    },
    {
      "localId": "visual_theme",
      "type": "visual_theme",
      "data": {
        "dubbing": {
          "mixMode": "duck",
          "targetLanguage": "{{target_language}}",
          "sourceMediaIncluded": false,
          "generatedAudioIncluded": false
        }
      }
    },
    {
      "localId": "speaker_structure",
      "type": "speaker_structure",
      "data": {
        "speakers": [
          {
            "localId": "speaker_dub",
            "name": "Dub Voice",
            "role": "narrator",
            "language": "{{target_language}}",
            "voicePlaceholder": "dub_voice"
          }
        ]
      }
    },
    {
      "localId": "subtitle_style",
      "type": "subtitle_style",
      "data": {
        "presetId": "clean"
      }
    }
  ],
  "placeholders": [
    {
      "id": "target_language",
      "label": "Target Language",
      "type": "language",
      "required": true,
      "languageMode": "user_select"
    },
    {
      "id": "dub_voice",
      "label": "Dub Voice",
      "type": "voice",
      "required": false,
      "languageMode": "project",
      "role": "narrator",
      "voiceCategory": "Narration"
    }
  ],
  "assets": [],
  "metadata": {
    "recommended": true,
    "structureOnly": true,
    "privateContentIncluded": false
  }
}