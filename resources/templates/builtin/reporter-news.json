{
  "id": "builtin-reporter-news",
  "name": "Reporter News",
  "templateType": "reporter",
  "category": "Reporter",
  "description": "Reporter composition with background B-roll, presenter chroma layer, lower third and captions.",
  "workflow": "news",
  "version": "1.0",
  "schemaVersion": 1,
  "builtin": true,
  "authorLabel": "MMO Video Studio",
  "previewImage": "",
  "tags": [
    "news",
    "reporter",
    "green-screen",
    "layered-video"
  ],
  "supportedAspectRatios": [
    "16:9",
    "9:16"
  ],
  "supportedLanguages": [
    "*"
  ],
  "requiredFeatures": [
    "news",
    "layered_video",
    "chroma_key",
    "multi_speaker",
    "subtitles"
  ],
  "components": [
    {
      "localId": "project_settings",
      "type": "project_settings",
      "data": {
        "workflow": "news",
        "fps": 30,
        "languageMode": "project"
      }
    },
    {
      "localId": "speaker_structure",
      "type": "speaker_structure",
      "data": {
        "speakers": [
          {
            "localId": "speaker_reporter",
            "name": "Reporter",
            "role": "reporter",
            "language": "{{project_language}}",
            "voicePlaceholder": "reporter_voice"
          }
        ]
      }
    },
    {
      "localId": "scene_structure",
      "type": "scene_structure",
      "data": {
        "scenes": [
          {
            "localId": "scene_report",
            "name": "Reporter Segment",
            "durationMs": 12000,
            "primaryMediaPlaceholder": "background_video",
            "fitMode": "fill",
            "layers": [
              {
                "localId": "layer_reporter",
                "mediaPlaceholder": "reporter_video",
                "role": "reporter",
                "speakerLocalId": "speaker_reporter",
                "x": 0.58,
                "y": 0.12,
                "width": 0.38,
                "height": 0.82,
                "fitMode": "contain",
                "chromaKey": {
                  "enabled": true,
                  "keyColor": "#00FF00",
                  "similarity": 0.22,
                  "blend": 0.08,
                  "spill": 0.06
                }
              }
            ],
            "overlays": [
              {
                "localId": "overlay_headline",
                "type": "headline",
                "text": "{{headline}}",
                "x": 0.06,
                "y": 0.06,
                "width": 0.88,
                "height": 0.15
              },
              {
                "localId": "overlay_reporter",
                "type": "lower_third",
                "text": "{{reporter_name}}",
                "secondaryText": "Reporter",
                "x": 0.06,
                "y": 0.76,
                "width": 0.5,
                "height": 0.16
              }
            ],
            "transitionOut": {
              "type": "cut",
              "durationMs": 0
            }
          }
        ]
      }
    },
    {
      "localId": "subtitle_style",
      "type": "subtitle_style",
      "data": {
        "presetId": "bold"
      }
    },
    {
      "localId": "news_theme",
      "type": "news_visual_theme",
      "data": {
        "themeRef": "clean_news",
        "claimsIncluded": false
      }
    },
    {
      "localId": "export",
      "type": "export_recommendation",
      "data": {
        "presetId": "generic_vertical"
      }
    }
  ],
  "placeholders": [
    {
      "id": "background_video",
      "label": "Background Video",
      "type": "video",
      "required": true,
      "languageMode": "project",
      "instructions": "Choose B-roll or a background video.",
      "acceptedMediaTypes": [
        "video"
      ]
    },
    {
      "id": "reporter_video",
      "label": "Reporter Video",
      "type": "video",
      "required": true,
      "languageMode": "project",
      "instructions": "Choose a reporter/presenter video. Green-screen friendly footage works best.",
      "acceptedMediaTypes": [
        "video"
      ]
    },
    {
      "id": "reporter_voice",
      "label": "Reporter Voice",
      "type": "voice",
      "required": false,
      "languageMode": "project",
      "role": "reporter",
      "voiceCategory": "News Anchor"
    },
    {
      "id": "reporter_name",
      "label": "Reporter Name",
      "type": "text",
      "required": false,
      "languageMode": "project"
    },
    {
      "id": "headline",
      "label": "Headline",
      "type": "text",
      "required": false,
      "languageMode": "project"
    }
  ],
  "assets": [],
  "metadata": {
    "recommended": true,
    "structureOnly": true,
    "privateContentIncluded": false
  }
}
