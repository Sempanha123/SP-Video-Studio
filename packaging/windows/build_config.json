{
  "schemaVersion": 1,
  "productName": "MMO Video Studio",
  "target": "Windows 11 x64",
  "python": "3.11",
  "packager": "Nuitka",
  "packagerVersion": "4.2.1",
  "pyside6Version": "6.11.2",
  "mode": "standalone-one-folder",
  "entrypoint": "main.py",
  "executable": "MMO Video Studio.exe",
  "runtimeDataRoot": "%LOCALAPPDATA%/MMOVideoStudio",
  "resources": [
    "ui/qml",
    "resources"
  ],
  "qtPlugins": [
    "qml",
    "platforms",
    "imageformats",
    "multimedia"
  ],
  "explicitDynamicPackages": [
    "faster_whisper",
    "ctranslate2",
    "voxcpm",
    "transformers",
    "torch",
    "sentencepiece",
    "soundfile"
  ],
  "ffmpeg": {
    "strategy": "bundled-at-build-time",
    "destination": "bin",
    "requiredFiles": [
      "ffmpeg.exe",
      "ffprobe.exe",
      "LICENSE.txt",
      "SOURCE.txt"
    ],
    "runtimeDownload": false
  },
  "models": {
    "bundledWeights": false,
    "root": "%LOCALAPPDATA%/MMOVideoStudio/models"
  },
  "releaseConsole": false,
  "debugConsole": true,
  "oneFile": false,
  "installer": {
    "technology": "Inno Setup",
    "compilerVersion": "7.1.0",
    "target": "Windows 11 x64",
    "script": "packaging/windows/installer/MMO-Video-Studio.iss",
    "scope": "per-user",
    "requiresElevation": false,
    "appId": "{38CE0934-A2D4-4D9B-9499-AEA7F28FC0EB}",
    "defaultInstallRoot": "%LOCALAPPDATA%/Programs/MMO Video Studio",
    "userDataRoot": "%LOCALAPPDATA%/MMOVideoStudio",
    "architecturesAllowed": "x64os"
  },
  "updates": {
    "channel": "stable",
    "officialManifestUrl": "",
    "manifestSchemaVersion": 1,
    "requiresHttps": true,
    "automaticInstallerDownload": false,
    "expectedAuthenticodeSignerSubject": "",
    "stagingRoot": "%LOCALAPPDATA%/MMOVideoStudio/updates"
  }
}
